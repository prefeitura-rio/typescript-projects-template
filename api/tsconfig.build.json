{
  // Used by tsup for production builds. Extends the base tsconfig but:
  //   - enables emit (tsup needs to produce output files)
  //   - excludes tests (they have no place in the compiled artefact)
  //   - disables incremental (clean, repeatable CI builds)
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/**/*.ts"]
}
