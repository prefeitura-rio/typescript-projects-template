{
  "name": "my-library",
  "version": "0.1.0",
  "description": "",
  "packageManager": "pnpm@10.11.0",

  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },

  "files": ["dist"],

  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "devDependencies": {
    "@types/node": "22.15.29",
    "@vitest/coverage-v8": "3.2.4",
    "oxlint": "0.16.7",
    "prettier": "3.5.3",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
