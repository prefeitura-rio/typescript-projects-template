# Production build output — published to npm from dist/
dist/

# Dependencies
node_modules/

# Environment variables — never commit plaintext secrets
.env
.env.local
.env.*.local

# Test output
coverage/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
.DS_Store?
._*
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# devenv / Nix — generated caches; never commit.
# devenv.lock and devenv.yaml MUST be committed (reproducibility).
.devenv/
.devenv.flake.nix

# Generated by devenv on shell entry; local-machine specific.
.pre-commit-config.yaml
